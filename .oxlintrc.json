{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "overrides": [
    {
      "files": ["vite.config.ts"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ]
}
